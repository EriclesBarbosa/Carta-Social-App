<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="venv_prod\Scripts\waitress-serve.exe"
                  arguments="--listen=127.0.0.1:%HTTP_PLATFORM_PORT% core.wsgi:application"
                  startupTimeLimit="120"
                  requestTimeout="00:10:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="logs\waitress.log">
    </httpPlatform>
  </system.webServer>
</configuration>
