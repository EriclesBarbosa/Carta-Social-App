<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <handlers>
      <clear />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\inetpub\wwwroot\mfids\venv_mfids\Scripts\python.exe" arguments="C:\inetpub\wwwroot\mfids\manage.py runserver %HTTP_PLATFORM_PORT%" stdoutLogEnabled="true" stdoutLogFile="C:\inetpub\wwwroot\mfids\logs\python.log">
      <environmentVariables>
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="core.settings" />
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\mfids" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>